# =============================================================================
# Test Environment Configuration Template
# =============================================================================
#
# SETUP INSTRUCTIONS:
# 1. Copy this file to .env.test:
#      cp .env.test.example .env.test
#
# 2. Fill in your API keys below
#
# 3. Run integration tests:
#      pytest -m integration
#
# SECURITY NOTE:
# - .env.test is gitignored and will NOT be committed
# - Never commit actual API keys to git
# - For CI/CD, use repository secrets instead
#
# =============================================================================

# OpenAI API Key (required for most integration tests)
# Get yours at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-key-here

# =============================================================================
# Optional: Override default settings for tests
# =============================================================================

# Use a cheaper/faster model for integration tests (optional)
# OPENAI_MODEL=gpt-4o-mini

# Reduce token usage for faster tests (optional)
# MAX_TOKENS=256
