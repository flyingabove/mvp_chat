{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/pre_push_beta_rebase.sh",
            "if": "Bash(git push*)",
            "timeout": 90,
            "statusMessage": "Syncing beta before push..."
          }
        ]
      }
    ]
  }
}
